# Maintainer: gerickt
# Coucou for Arch Linux: the coucou-daemon plus the Noctalia Mochi widget.

pkgname=coucou-git
_pkgname=coucou
pkgver=0.4.0
pkgrel=1
pkgdesc="Mochi, a Noctalia bar widget that shows what your AI coding agents are doing"
arch=('x86_64' 'aarch64')
url="https://github.com/gerickt/coucou"
license=("MIT" "LicenseRef-coucou-assets")
depends=('noctalia-shell' 'xdg-utils')
makedepends=('git' 'cargo')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto' '!debug')
source=("$_pkgname::git+https://github.com/gerickt/coucou.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local v
  v=$(sed -n 's/^version = "\(.*\)"/\1/p' daemon/Cargo.toml | head -1)
  printf "%s.r%s.%s" "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$_pkgname/daemon"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$PWD/target"
  cargo build --release --locked
}

package() {
  cd "$_pkgname"
  install -Dm755 daemon/target/release/coucou-daemon "$pkgdir/usr/bin/coucou-daemon"
  install -d "$pkgdir/usr/share/noctalia/plugins/coucou-mochi"
  cp -r noctalia/. "$pkgdir/usr/share/noctalia/plugins/coucou-mochi/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-ASSETS.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE-ASSETS.md"
}
