[Unit]
Description=Coucou daemon: relays AI coding agent hooks to Mochi in Noctalia
Documentation=https://github.com/gerickt/coucou
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/coucou-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
